# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/game_memory_db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# App
APP_NAME=Game Memory AI
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500"]

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
